@model dynamic
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}
<h2>Admin Dashboard</h2>
<div class="row">
  <div class="col-md-3"><div class="card p-3"><strong>Users</strong><div>@Model.Users</div></div></div>
  <div class="col-md-3"><div class="card p-3"><strong>Vendors</strong><div>@Model.Vendors</div></div></div>
  <div class="col-md-3"><div class="card p-3"><strong>Buses</strong><div>@Model.Buses</div></div></div>
  <div class="col-md-3"><div class="card p-3"><strong>Bookings</strong><div>@Model.Bookings</div></div></div>
</div>
<div class="card p-3 mt-3"><strong>Total Revenue:</strong> @Model.Revenue</div>
