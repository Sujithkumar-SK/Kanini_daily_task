@{
    Layout = "_Layout";
    ViewData["Title"] = "Search";
}
<h2>Search Buses</h2>
<form method="post" action="/Search/Results" class="card p-3 bg-white shadow-sm">
  <div class="row g-3">
    <div class="col-md-4">
      <label>Source</label>
      <input name="source" class="form-control" required />
    </div>
    <div class="col-md-4">
      <label>Destination</label>
      <input name="destination" class="form-control" required />
    </div>
    <div class="col-md-4">
      <label>Travel Date</label>
      <input type="date" name="travelDate" class="form-control" required />
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary">Search</button>
  </div>
</form>
